# Скопируйте в .env и подставьте ключ. Файл .env в git не входит.
# Процесс сам .env не читает: переменные должны быть в окружении.
#
#   Copy-Item .env.example .env
#   Get-Content .env | Where-Object { $_ -and $_ -notmatch '^\s*#' } | ForEach-Object {
#     $name, $value = $_.Split('=', 2)
#     Set-Item -Path "Env:$name" -Value $value
#   }

# Модель — приложение Dify, к которому она подключена. Имя модели задаётся там.
# Если заданы обе переменные, vLLM ниже не используется.
# OPENAPI_DIFY_BASE_URL=https://dify.example/v1
# OPENAPI_DIFY_API_KEY=
# OPENAPI_DIFY_USER=openapi-from-spec

# Запасной путь без Dify. Локальный Ollama: POST /api/chat. Ключ не нужен.
OPENAPI_VLLM_BASE_URL=http://127.0.0.1:11434/api
OPENAPI_VLLM_MODEL=qwen3.6:27b
OPENAPI_VLLM_API_KEY=

# Облачный OpenAI-совместимый /v1. Клиент дописывает /chat/completions.
# OPENAPI_VLLM_BASE_URL=https://api.mistral.ai/v1
# OPENAPI_VLLM_MODEL=mistral-small-latest
# OPENAPI_VLLM_API_KEY=

# Необязательно. Без этих двух переменных остаётся разбор известных таблиц без модели.
# OPENAPI_TITLE=API
# OPENAPI_VERSION=1.0.0
# OPENAPI_PATH_PREFIX=/api/v1
# OPENAPI_SERVER_URL=https://example.test
# OPENAPI_SKILL_DIR=
# OPENAPI_AGENT_BRIDGE_DIR=out/agent-bridge
